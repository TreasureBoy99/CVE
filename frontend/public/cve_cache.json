  "cves": [
    {
      "id": "CVE-2026-67191",
      "publishedDate": "2026-07-29T15:50:53.320Z",
      "lastModifiedDate": "2026-07-29T16:32:49.768Z",
      "description": "Xlight FTP Server before 3.9.5 contains a pre-authentication heap buffer overflow vulnerability that allows remote unauthenticated attackers to write past the end of a heap buffer by sending a malformed SSH client identification string. A logic error in the recv loop's termination condition uses an incorrect OR operator where an AND operator is required, enabling exploitation on any SSH or SFTP connection before authentication occurs.",
      "severity": 9.8,
      "fix_suggestion": "📦 受影响组件：Xlight Xlight FTP Server\n🛠️ 修复建议：\n1. 确认受影响的版本范围（见上方 Affected Products）\n2. 升级到厂商官方发布的最稳定安全版本\n3. 检查官方安全公告获取补丁链接\n4. 如无法立即升级，实施临时缓解措施：\n   - 网络层：WAF 规则 / IPS 签名 / 零信任策略\n   - 主机层：最小化暴露面 / 禁用危险功能 / 输入过滤\n5. 修复后使用 NVD / 厂商 PoC 验证修复有效性",
      "references": [
        {
          "url": "https://www.xlightftpd.com/whatsnew.htm",
          "type": "reference"
        },
        {
          "url": "https://www.vulncheck.com/advisories/xlight-ftp-server-pre-auth-heap-buffer-overflow-via-ssh-parser",
          "type": "reference"
        }
      ],
      "affected": [
        {
          "defaultStatus": "affected",
