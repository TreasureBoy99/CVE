    {
      "id": "CVE-2026-14803",
      "publishedDate": "2026-07-06T01:34:43.872Z",
      "lastModifiedDate": "2026-07-06T05:27:01.702Z",
      "description": "Mojo::JSON versions before 9.47 for Perl allow memory exhaustion via unbounded recursion in the pure-Perl decoder.\n\nThe pure-Perl decode path (`_decode_value` dispatching to `_decode_array` and `_decode_object`) recurses with no depth limit, so a small deeply nested JSON document can consume excessive memory.\n\nThis path is the default when Cpanel::JSON::XS is not installed or `MOJO_NO_JSON_XS=1` is set; the Cpanel::JSON::XS fast path is not affected.\n\nAny caller that decodes an untrusted JSON body, for example `Mojo::Message::json` reached through `$c->req->json`, can exhaust process memory and cause denial of service.",
      "severity": "N/A",
      "references": [
        {
          "url": "https://github.com/mojolicious/mojo/commit/cc38b0554275c4d84f6b8b49bcbbc1bec2068fe1.patch",
          "type": "reference"
        },
        {
          "url": "https://metacpan.org/release/SRI/Mojolicious-9.47/changes",
          "type": "reference"
        }
      ],
      "affected": [
        {
          "collectionURL": "https://cpan.org/modules",
          "defaultStatus": "unaffected",
          "packageName": "Mojolicious",
          "product": "Mojo::JSON",
          "programFiles": [
            "lib/Mojo/JSON.pm"
          ],
          "programRoutines": [
            {
              "name": "Mojo::JSON::_decode_array"
            },
            {
              "name": "Mojo::JSON::_decode_object"
            }
          ],
          "repo": "https://github.com/mojolicious/mojo",
          "vendor": "SRI",
          "versions": [
            {
              "lessThan": "9.47",
              "status": "affected",
              "version": "0",
              "versionType": "custom"
            }
          ]
        }
      ],
      "problemType": [
        "CWE-674 Uncontrolled Recursion"
      ],
      "fix_suggestion": "无法生成修复建议"
    }
